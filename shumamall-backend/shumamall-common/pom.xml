<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shumamall</groupId>
        <artifactId>shumamall-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>shumamall-common</artifactId>
    <packaging>jar</packaging>

    <name>ShuMaMall Common</name>
    <description>公共模块：统一返回、异常、工具类、TraceId 透传</description>

    <dependencies>
        <!-- Spring Boot Starter（不含 Web，纯核心） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring Boot AOP（@Aspect、@Before 等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Spring Boot Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Spring Boot Actuator：提供 /actuator/health 及 liveness / readiness 探针，
            供 docker-compose.app.yml 各服务的 healthcheck 使用（探的是 liveness，
            理由见该文件「健康检查」一节），不再靠端口连通性猜服务起没起来。

            Spring Boot 3 默认只暴露 health 一个端点
            （management.endpoints.web.exposure.include 默认值即 health），
            env / beans / heapdump 等敏感端点不开；liveness / readiness 是 health 的
            子路径，随 health 一起暴露（需打开 probes，见 compose 的 x-common-env）。
            因此各服务无需再加暴露配置，也不用改鉴权白名单
            （TokenFilter 只挂在 /api/v1/** 上，本来就不拦 /actuator/**）。

            放在 common 里与 resilience4j 同理：13 个服务行为一致，不必逐个 pom 维护。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Cloud OpenFeign -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!--
            Resilience4j 熔断：@FeignClient 的 fallback / fallbackFactory 依赖它。
            放在 common 里意味着所有微服务都具备该能力，但真正生效还需各服务显式打开
            spring.cloud.openfeign.circuitbreaker.enabled=true（按服务灰度开启，
            避免一次性改变全部服务间调用的行为）。
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>

        <!-- Nacos 配置中心 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- MySQL Driver -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- MyBatis-Plus（MetaObjectHandler 使用） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- JJWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Servlet API（Filter 接口用，Gateway 不含 servlet） -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            Spring Data Redis：请求签名的防重放 nonce 需要 Redis SET NX EX。
            标 optional，只用于本模块编译（RequestSignFilter 的构造参数类型），
            不向下游传递——真正要用它的 order / payment 服务各自已引入
            spring-boot-starter-data-redis，用不到的服务（如 gateway）不会被强塞一份 Redis 依赖。
        -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            springdoc-openapi：本模块只用来编译统一 OpenAPI 配置（common.config.OpenApiConfig）。
            标 optional 不向下游传递，各 WebMVC 服务自行引入 starter，
            gateway（WebFlux，与 webmvc-ui 互斥）就不必被迫排除依赖。
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
